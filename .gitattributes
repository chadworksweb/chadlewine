# Deploy-critical files MUST stay LF -- they are checked out and executed on the
# Linux droplet (le-projects-01). A CRLF shebang (`#!/usr/bin/env bash\r`) breaks
# the deploy scripts, and CRLF in the Dockerfile/compose/nginx confs is fragile.
Dockerfile      text eol=lf
*.sh            text eol=lf
*.yml           text eol=lf
*.yaml          text eol=lf
*.conf          text eol=lf
.dockerignore   text eol=lf
.gitattributes  text eol=lf
